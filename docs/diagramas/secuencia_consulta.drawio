        </mxCell>
        <mxCell id="nota_vueltas" value="&lt;b&gt;Las 4 vueltas del ejemplo (req_01)&lt;/b&gt;&lt;br&gt;1  SM1.interpretacion_pedido (L1)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;perfil dominante VIRT (0,899)&lt;br&gt;2  SM4.recomendar (Q1, Q2, Q3, Q6B)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;A puesto 1 (0,785), H 2, B 3 (REC-R8)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;X fuera de presupuesto, M condicionada&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;E, C y K descartadas, G indeterminada&lt;br&gt;3  SM2.riesgo_ram (C2)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;G: riesgo [49,58 ; 81,46] (rango, alto)&lt;br&gt;4  SM3.buscar (orden grafica)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;adecuación gráfica por notebook (C: 0,941)" style="html=1;whiteSpace=wrap;fillColor=#fffbee;strokeColor=#d6b656;strokeWidth=1;fontSize=10;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=8;align=left;verticalAlign=top;spacing=4;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="346" width="258" height="168" as="geometry" />
        </mxCell>
        <mxCell id="nota_cortos" value="&lt;b&gt;Caminos cortos (sin explicador)&lt;/b&gt;&lt;br&gt;Entrada inválida → origen_respuesta = validacion · fuera de alcance → mensaje fijo, sin tocar el grafo · plan con aclaración → la pregunta&lt;br&gt;Neo4j u Ollama no responden → origen_respuesta = error, con un mensaje fijo. En todos los casos el orquestador escribe la traza." style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=10.5;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=8;align=left;verticalAlign=top;spacing=4;spacingLeft=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="758" width="1119" height="54" as="geometry" />
