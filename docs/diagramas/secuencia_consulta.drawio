        <mxCell id="fr2_t" value="[hasta 3 intentos (1 + 2 regeneraciones); sale en cuanto verificar() no da problemas]" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10.5;fontColor=#111111;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;" vertex="1" parent="1">
