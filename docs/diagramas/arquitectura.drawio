        <mxCell id="llm" value="&lt;b&gt;3 · Modelo de lenguaje (LLM)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 10px;&quot;&gt;asistente/llm.py&lt;/font&gt;&lt;br&gt;LangChain: ChatPromptTemplate | ChatOllama&lt;br&gt;Ollama local · qwen2.5:3b · temperatura 0 · salida estructurada&lt;br&gt;Interpreta (plan JSON) y redacta; no calcula ni escribe Cypher" style="html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
