        <mxCell id="router" value="&lt;b&gt;Router (prompt maestro)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 9.5px;&quot;&gt;router.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 9.5px;&quot;&gt;prompts/maestro.txt&lt;/font&gt;&lt;br&gt;texto → plan JSON de&lt;br&gt;intenciones cerradas (13)&lt;br&gt;y modelos del catálogo&lt;br&gt;validar() en Python: descarta&lt;br&gt;lo inventado; nunca asume&lt;br&gt;req_01" style="html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10.5;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="orq_c">
          <mxGeometry x="12" y="37" width="173" height="150" as="geometry" />
        </mxCell>
        <mxCell id="explicador" value="&lt;b&gt;Explicador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 9.5px;&quot;&gt;explicador.py&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 9.5px;&quot;&gt;prompts/explicacion.txt&lt;/font&gt;&lt;br&gt;redacta solo con la evidencia&lt;br&gt;(voseo, ≤ 180 palabras)&lt;br&gt;verificar(): cifras, modelos,&lt;br&gt;reglas, alertas, rangos y&lt;br&gt;estados · ≤ 2 regeneraciones&lt;br&gt;→ plantilla fija" style="html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10.5;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="orq_c">
          <mxGeometry x="195" y="37" width="173" height="150" as="geometry" />
        </mxCell>
        <mxCell id="orquestador" value="&lt;b&gt;Orquestador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size: 9.5px;&quot;&gt;asistente/orquestador.py · Orquestador.consultar()&lt;/font&gt;&lt;br&gt;prevalida · lee catálogo y pedidos · pide y valida el plan&lt;br&gt;despacha con RunnableLambda · arma la evidencia común&lt;br&gt;(siempre con L1 si hay pedido) · llama al explicador" style="html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10.5;fontColor=#111111;rounded=1;absoluteArcSize=1;arcSize=16;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="orq_c">
